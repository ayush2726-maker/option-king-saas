# ─── Option King AI SaaS — Environment Variables ───────────────────
# Copy this to .env and fill in your values

# Server
PORT=8001

# Security — CHANGE THESE IN PRODUCTION!
SECRET_KEY=option-king-super-secret-change-this-now-2024
ENCRYPT_KEY=your-32-byte-fernet-key-here

# Admin Account (auto-created on first run)
ADMIN_EMAIL=admin@optionking.ai
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Ayush

# Razorpay
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Paytm Dynamic Payment Links
PAYTM_ENV=staging
PAYTM_MID=your_paytm_merchant_id
PAYTM_MERCHANT_KEY=your_paytm_merchant_key
# Only needed if Paytm issued multiple keys/client IDs.
PAYTM_CLIENT_ID=
# Optional host override. Leave unset to use the environment default.
# PAYTM_API_BASE_URL=https://securestage.paytmpayments.com
PAYTM_LINK_CALLBACK_URL=https://option-king-saas-production.up.railway.app/subscription/paytm/webhook
PAYTM_LINK_RETURN_URL=https://option-king-saas-production.up.railway.app/subscription/paytm/return

# Database
DB_PATH=option_king_saas.db
